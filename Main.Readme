%% ============================================================
% PRINT MODEL INFORMATION
%% ============================================================

fprintf("\n");
fprintf("============================================\n");
fprintf("       LANDSLIDE DIGITAL TWIN\n");
fprintf("============================================\n");

fprintf("Grid size          : %d x %d\n", ...
    gridSize,gridSize);

fprintf("Elevation range    : %.2f - %.2f m\n", ...
    min(terrain(:)), ...
    max(terrain(:)));

fprintf("Average slope      : %.2f degrees\n", ...
    mean(slopeDegrees(:)));

fprintf("Dry minimum FoS    : %.2f\n", ...
    min(FoS(:)));

fprintf("============================================\n");
fprintf("Dashboard ready.\n");
fprintf("============================================\n");



%% ============================================================
% FUNCTION: CREATE RAINFALL EVENT
%% ============================================================

function rainfall = ...
    createRainfallEvent(intensity)


rainfall = ...
    [ ...
    0 ...
    intensity*0.10 ...
    intensity*0.20 ...
    intensity*0.30 ...
    intensity*0.40 ...
    intensity*0.60 ...
    intensity*0.80 ...
    intensity ...
    ];

end



%% ============================================================
% FUNCTION: CALCULATE SIMULATION
%% ============================================================

function [ ...
    FoS_time, ...
    soilSaturation, ...
    porePressure, ...
    minimumFoS] = ...
    calculateSimulation( ...
    rainfall, ...
    slopeRadiansSafe, ...
    cohesion, ...
    frictionRadians, ...
    gamma, ...
    soilDepth, ...
    gammaWater, ...
    soilWaterCapacity, ...
    infiltrationFraction)


%% ------------------------------------------------------------
% INFILTRATED RAIN
%% ------------------------------------------------------------

infiltratedRain = ...
    rainfall .* ...
    infiltrationFraction;


%% ------------------------------------------------------------
% SOIL WATER
%% ------------------------------------------------------------

soilWater = ...
    zeros(size(rainfall));


for t = 1:length(rainfall)

    if t == 1

        soilWater(t) = ...
            min( ...
            infiltratedRain(t), ...
            soilWaterCapacity);

    else

        soilWater(t) = ...
            min( ...
            soilWater(t-1) ...
            + infiltratedRain(t), ...
            soilWaterCapacity);

    end

end


%% ------------------------------------------------------------
% SATURATION
%% ------------------------------------------------------------

soilSaturation = ...
    soilWater ./ ...
    soilWaterCapacity;


soilSaturation = ...
    min(soilSaturation,1);


%% ------------------------------------------------------------
% PORE PRESSURE
%% ------------------------------------------------------------

porePressure = ...
    soilSaturation .* ...
    gammaWater .* ...
    soilDepth;


%% ------------------------------------------------------------
% FoS
%% ------------------------------------------------------------

numRows = ...
    size(slopeRadiansSafe,1);

numCols = ...
    size(slopeRadiansSafe,2);


FoS_time = ...
    zeros( ...
    numRows, ...
    numCols, ...
    length(rainfall));


for t = 1:length(rainfall)

    u = ...
        soilSaturation(t) ...
        .* gammaWater ...
        .* soilDepth ...
        .* cos(slopeRadiansSafe).^2;


    effectiveNormalStress = ...
        gamma .* soilDepth ...
        .* cos(slopeRadiansSafe).^2 ...
        - u;


    FoS_time(:,:,t) = ...
        ( ...
        cohesion ...
        + effectiveNormalStress ...
        .* tan(frictionRadians) ...
        ) ...
        ./ ...
        ( ...
        gamma .* soilDepth ...
        .* sin(slopeRadiansSafe) ...
        .* cos(slopeRadiansSafe) ...
        );

end


%% ------------------------------------------------------------
% MINIMUM FoS
%% ------------------------------------------------------------

minimumFoS = ...
    zeros(size(rainfall));


for t = 1:length(rainfall)

    minimumFoS(t) = ...
        min( ...
        FoS_time(:,:,t), ...
        [], ...
        "all");

end

end



%% ============================================================
% FUNCTION: UPDATE DASHBOARD
%% ============================================================

function updateDashboard( ...
    dashboard, ...
    dashboardAxes, ...
    fosAxes, ...
    rainAxes, ...
    riskLabel, ...
    fosLabel, ...
    rainfallLabel, ...
    saturationLabel, ...
    pressureLabel, ...
    areaLabel, ...
    housesLabel, ...
    roadsLabel, ...
    hourLabel, ...
    hourStatusLabel, ...
    rainValueLabel, ...
    actionLabel)


%% ------------------------------------------------------------
% GET STATE
%% ------------------------------------------------------------

state = dashboard.UserData;


%% ------------------------------------------------------------
% GET SLIDER
%% ------------------------------------------------------------

sliders = ...
    findall( ...
    dashboard, ...
    "Type","uislider");


if isempty(sliders)

    return;

end


timeSlider = sliders(1);


%% ------------------------------------------------------------
% CURRENT TIME INDEX
%% ------------------------------------------------------------

tIndex = ...
    round(timeSlider.Value);


tIndex = ...
    max( ...
    1, ...
    min( ...
    length(state.rainfall), ...
    tIndex));


%% ------------------------------------------------------------
% CURRENT VALUES
%% ------------------------------------------------------------

currentFoS = ...
    state.FoS_time(:,:,tIndex);


currentHour = ...
    state.time(tIndex);


currentRainfall = ...
    state.rainfall(tIndex);


currentSaturation = ...
    state.soilSaturation(tIndex);


currentPressure = ...
    state.porePressure(tIndex);


currentMinimumFoS = ...
    min(currentFoS(:));


cumulativeRainfall = ...
    sum(state.rainfall(1:tIndex));


%% ============================================================
% RISK MAP
%% ============================================================

riskMap = ...
    zeros(size(currentFoS));


% LOW

riskMap(currentFoS > 1.5) = 1;


% MODERATE

riskMap( ...
    currentFoS >= 1.2 & ...
    currentFoS <= 1.5) = 2;


% HIGH

riskMap( ...
    currentFoS >= 1.0 & ...
    currentFoS < 1.2) = 3;


% EXTREME

riskMap(currentFoS < 1.0) = 4;


%% ============================================================
% RISK PERCENTAGES
%% ============================================================

totalCells = numel(currentFoS);


extremePercentage = ...
    sum(currentFoS(:) < 1.0) ...
    / totalCells * 100;


highPercentage = ...
    sum( ...
    currentFoS(:) >= 1.0 & ...
    currentFoS(:) < 1.2) ...
    / totalCells * 100;


moderatePercentage = ...
    sum( ...
    currentFoS(:) >= 1.2 & ...
    currentFoS(:) <= 1.5) ...
    / totalCells * 100;


%% ============================================================
% OVERALL RISK
%% ============================================================

if extremePercentage >= 20

    overallRisk = "EXTREME";

    action = ...
        "IMMEDIATE EVACUATION";

    riskColor = ...
        [0.90 0.20 0.25];


elseif extremePercentage >= 5 || ...
        highPercentage >= 25

    overallRisk = "HIGH";

    action = ...
        "EVACUATE HIGH-RISK REGION";

    riskColor = ...
        [0.95 0.50 0.20];


elseif highPercentage >= 10 || ...
        moderatePercentage >= 25

    overallRisk = "MODERATE";

    action = ...
        "ISSUE WARNING";

    riskColor = ...
        [0.95 0.78 0.20];


else

    overallRisk = "LOW";

    action = ...
        "MONITOR REGION";

    riskColor = ...
        [0.30 0.80 0.45];

end


%% ============================================================
% HOUSES
%% ============================================================

houses = state.houses;


houseX = ...
    round(houses(:,1));


houseY = ...
    round(houses(:,2));


houseX = ...
    max( ...
    1, ...
    min( ...
    size(currentFoS,2), ...
    houseX));


houseY = ...
    max( ...
    1, ...
    min( ...
    size(currentFoS,1), ...
    houseY));


houseFoS = ...
    zeros(size(houseX));


for h = 1:length(houseX)

    houseFoS(h) = ...
        currentFoS( ...
        houseY(h), ...
        houseX(h));

end


affectedHouse = ...
    houseFoS < 1.2;


safeHouse = ...
    ~affectedHouse;


affectedHouses = ...
    sum(affectedHouse);


%% ============================================================
% ROAD
%% ============================================================

roads = state.roads;


roadX = roads(:,1);

roadY = roads(:,2);


roadXi = round(roadX);

roadYi = round(roadY);


roadXi = ...
    max( ...
    1, ...
    min( ...
    size(currentFoS,2), ...
    roadXi));


roadYi = ...
    max( ...
    1, ...
    min( ...
    size(currentFoS,1), ...
    roadYi));


roadFoS = ...
    zeros(size(roadXi));


for r = 1:length(roadXi)

    roadFoS(r) = ...
        currentFoS( ...
        roadYi(r), ...
        roadXi(r));

end


affectedRoad = ...
    roadFoS < 1.2;


affectedRoadPoints = ...
    sum(affectedRoad);


roadPercentage = ...
    affectedRoadPoints ...
    / length(roadX) * 100;


if roadPercentage >= 20

    affectedRoads = 1;

else

    affectedRoads = 0;

end


%% ============================================================
% AFFECTED AREA
%% ============================================================

affectedCells = ...
    currentFoS < 1.2;


cellArea = 0.001;


affectedArea = ...
    sum(affectedCells(:)) ...
    * cellArea;


%% ============================================================
% DRAW RISK MAP
%% ============================================================

cla(dashboardAxes);


imagesc( ...
    dashboardAxes, ...
    state.x(1,:), ...
    state.y(:,1), ...
    riskMap);


axis( ...
    dashboardAxes, ...
    "image");


set( ...
    dashboardAxes, ...
    "YDir","normal");


colormap( ...
    dashboardAxes, ...
    [ ...
    0.25 0.70 0.42
    0.90 0.78 0.20
    0.92 0.48 0.18
    0.82 0.18 0.20
    ]);


caxis( ...
    dashboardAxes, ...
    [1 4]);


hold( ...
    dashboardAxes, ...
    "on");


%% ============================================================
% SAFE HOUSES
%% ============================================================

scatter( ...
    dashboardAxes, ...
    houseX(safeHouse), ...
    houseY(safeHouse), ...
    55, ...
    "o", ...
    "MarkerFaceColor",[0.20 0.90 0.45], ...
    "MarkerEdgeColor",[1 1 1], ...
    "LineWidth",1);


%% ============================================================
% AFFECTED HOUSES
%% ============================================================

scatter( ...
    dashboardAxes, ...
    houseX(affectedHouse), ...
    houseY(affectedHouse), ...
    100, ...
    "o", ...
    "MarkerFaceColor",[0.95 0.08 0.08], ...
    "MarkerEdgeColor",[1 1 1], ...
    "LineWidth",2);


%% ============================================================
% ROAD
%% ============================================================

plot( ...
    dashboardAxes, ...
    roadX, ...
    roadY, ...
    "-", ...
    "Color",[0.95 0.95 0.95], ...
    "LineWidth",4);


%% ============================================================
% AFFECTED ROAD
%% ============================================================

for r = 1:length(roadX)-1

    if affectedRoad(r) || ...
            affectedRoad(r+1)

        plot( ...
            dashboardAxes, ...
            roadX(r:r+1), ...
            roadY(r:r+1), ...
            "-", ...
            "Color",[0.95 0.08 0.08], ...
            "LineWidth",7);

    end

end


%% ============================================================
% MAP TITLE
%% ============================================================

title( ...
    dashboardAxes, ...
    sprintf( ...
    "LIVE RISK MAP  |  HOUR %d", ...
    currentHour), ...
    "FontWeight","bold");


xlabel( ...
    dashboardAxes, ...
    "X Coordinate");


ylabel( ...
    dashboardAxes, ...
    "Y Coordinate");


%% ============================================================
% LEGEND
%% ============================================================

safeLegend = ...
    scatter( ...
    dashboardAxes, ...
    nan,nan, ...
    55, ...
    "o", ...
    "MarkerFaceColor",[0.20 0.90 0.45], ...
    "MarkerEdgeColor",[1 1 1]);


affectedLegend = ...
    scatter( ...
    dashboardAxes, ...
    nan,nan, ...
    90, ...
    "o", ...
    "MarkerFaceColor",[0.95 0.08 0.08], ...
    "MarkerEdgeColor",[1 1 1]);


roadLegend = ...
    plot( ...
    dashboardAxes, ...
    nan,nan, ...
    "-", ...
    "Color",[0.95 0.95 0.95], ...
    "LineWidth",4);


affectedRoadLegend = ...
    plot( ...
    dashboardAxes, ...
    nan,nan, ...
    "-", ...
    "Color",[0.95 0.08 0.08], ...
    "LineWidth",6);


legend( ...
    dashboardAxes, ...
    [ ...
    safeLegend ...
    affectedLegend ...
    roadLegend ...
    affectedRoadLegend ...
    ], ...
    { ...
    "Safe House", ...
    "Affected House", ...
    "Road", ...
    "Affected Road" ...
    }, ...
    "Location","southoutside", ...
    "FontSize",8);


hold( ...
    dashboardAxes, ...
    "off");


%% ============================================================
% UPDATE STATUS
%% ============================================================

riskLabel.Text = ...
    char(overallRisk);


riskLabel.FontColor = ...
    riskColor;


fosLabel.Text = ...
    sprintf("%.2f",currentMinimumFoS);


rainfallLabel.Text = ...
    sprintf("%.0f mm",cumulativeRainfall);


saturationLabel.Text = ...
    sprintf("%.0f %%",currentSaturation*100);


pressureLabel.Text = ...
    sprintf("%.1f kPa",currentPressure);


hourLabel.Text = ...
    sprintf("HOUR %d",currentHour);


hourStatusLabel.Text = ...
    sprintf( ...
    "SIMULATION TIME   HOUR %d", ...
    currentHour);


rainValueLabel.Text = ...
    sprintf( ...
    "Rainfall this hour: %.0f mm", ...
    currentRainfall);


areaLabel.Text = ...
    sprintf("%.2f km²",affectedArea);


housesLabel.Text = ...
    sprintf( ...
    "%d / %d", ...
    affectedHouses, ...
    length(houses));


roadsLabel.Text = ...
    sprintf( ...
    "%d / 1", ...
    affectedRoads);


actionLabel.Text = ...
    char(action);


actionLabel.FontColor = ...
    riskColor;


%% ============================================================
% FoS GRAPH
%% ============================================================

cla(fosAxes);


plot( ...
    fosAxes, ...
    state.time, ...
    state.minimumFoS, ...
    "-o", ...
    "LineWidth",2);


hold(fosAxes,"on");


plot( ...
    fosAxes, ...
    currentHour, ...
    currentMinimumFoS, ...
    "o", ...
    "MarkerSize",9, ...
    "LineWidth",2);


yline( ...
    fosAxes, ...
    1.0, ...
    "--", ...
    "LineWidth",1);


hold(fosAxes,"off");


xlabel(fosAxes,"Time");

ylabel(fosAxes,"Min FoS");

title( ...
    fosAxes, ...
    "SLOPE STABILITY", ...
    "FontWeight","bold");


grid(fosAxes,"on");


%% ============================================================
% RAINFALL GRAPH
%% ============================================================

cla(rainAxes);


bar( ...
    rainAxes, ...
    state.time, ...
    state.rainfall);


hold(rainAxes,"on");


plot( ...
    rainAxes, ...
    currentHour, ...
    currentRainfall, ...
    "o", ...
    "MarkerSize",8, ...
    "LineWidth",2);


hold(rainAxes,"off");


xlabel(rainAxes,"Time");

ylabel(rainAxes,"Rain");


title( ...
    rainAxes, ...
    "RAINFALL EVENT", ...
    "FontWeight","bold");


grid(rainAxes,"on");


%% ============================================================
% REFRESH
%% ============================================================

drawnow;

end



%% ============================================================
% FUNCTION: APPLY RAINFALL
%% ============================================================

function applyRainfall( ...
    dashboard, ...
    rainfallInput, ...
    timeSlider, ...
    dashboardAxes, ...
    fosAxes, ...
    rainAxes, ...
    riskLabel, ...
    fosLabel, ...
    rainfallLabel, ...
    saturationLabel, ...
    pressureLabel, ...
    areaLabel, ...
    housesLabel, ...
    roadsLabel, ...
    hourLabel, ...
    hourStatusLabel, ...
    rainValueLabel, ...
    actionLabel)


%% ------------------------------------------------------------
% READ INPUT
%% ------------------------------------------------------------

intensity = ...
    rainfallInput.Value;


if isempty(intensity) || ...
        isnan(intensity) || ...
        intensity < 0

    intensity = 0;

    rainfallInput.Value = 0;

end


%% ------------------------------------------------------------
% CREATE NEW RAINFALL
%% ------------------------------------------------------------

rainfall = ...
    createRainfallEvent(intensity);


%% ------------------------------------------------------------
% GET STATE
%% ------------------------------------------------------------

state = dashboard.UserData;


%% ------------------------------------------------------------
% RECALCULATE
%% ------------------------------------------------------------

[ ...
    FoS_time, ...
    soilSaturation, ...
    porePressure, ...
    minimumFoS] = ...
    calculateSimulation( ...
    rainfall, ...
    state.slopeRadiansSafe, ...
    state.cohesion, ...
    state.frictionRadians, ...
    state.gamma, ...
    state.soilDepth, ...
    state.gammaWater, ...
    state.soilWaterCapacity, ...
    state.infiltrationFraction);


%% ------------------------------------------------------------
% UPDATE STATE
%% ------------------------------------------------------------

state.rainfall = rainfall;

state.FoS_time = FoS_time;

state.soilSaturation = ...
    soilSaturation;

state.porePressure = ...
    porePressure;

state.minimumFoS = ...
    minimumFoS;


dashboard.UserData = state;


%% ------------------------------------------------------------
% RESET SLIDER
%% ------------------------------------------------------------

timeSlider.Limits = ...
    [1 length(rainfall)];


timeSlider.MajorTicks = ...
    1:length(rainfall);


timeSlider.Value = 1;


%% ------------------------------------------------------------
% UPDATE DASHBOARD
%% ------------------------------------------------------------

updateDashboard( ...
    dashboard, ...
    dashboardAxes, ...
    fosAxes, ...
    rainAxes, ...
    riskLabel, ...
    fosLabel, ...
    rainfallLabel, ...
    saturationLabel, ...
    pressureLabel, ...
    areaLabel, ...
    housesLabel, ...
    roadsLabel, ...
    hourLabel, ...
    hourStatusLabel, ...
    rainValueLabel, ...
    actionLabel);


end
