    rainfallTable.Date, ...
    rainfallTable.Rainfall_mm, ...
    soilMoisture.SoilMoisture_pct, ...
    FS_data, ...
    riskScore, ...
    riskLevel, ...
    'VariableNames', ...
    {'Date','Rainfall_mm','SoilMoisture_pct', ...
     'FactorOfSafety','RiskScore','RiskLevel'});

writetable(results,'landslide_risk_output.csv');

