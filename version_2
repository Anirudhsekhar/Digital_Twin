%% ============================================================
% LOCAL FUNCTION - DATA RAINFALL GENERATION
%% ============================================================
function rainfallTable = generateSyntheticRainfall(numDays,seed)
rng(seed);
startDate = datetime('today') - days(numDays-1);
dates = (startDate:datetime('today'))';
baseRain = abs(5*randn(numDays,1));
burstMask = rand(numDays,1) < 0.15;
burstRain = burstMask .* (40 + 30*rand(numDays,1));
rainfall = round(baseRain + burstRain,1);
rainfallTable = table(dates,rainfall, ...
    'VariableNames',{'Date','Rainfall_mm'});
end


%% ============================================================
% LOCAL FUNCTION - DATA TERRAIN GENERATION
%% ============================================================
function terrain = generateSyntheticTerrain(numPoints)
slopeAngle = 15 + 35*rand(numPoints,1);
cohesion = 5 + 20*rand(numPoints,1);
terrain = table(slopeAngle,cohesion, ...
    'VariableNames',{'SlopeAngle_deg','SoilCohesion_kPa'});
end


%% ============================================================
% LOCAL FUNCTION - DATA SOIL MOISTURE
%% ============================================================
function soilMoisture = generateSyntheticSoilMoisture(numDays,rainfallTable)
decayRate = 0.85;
moisture = zeros(numDays,1);
moisture(1) = 20;
for i = 2:numDays
    moisture(i) = decayRate*moisture(i-1) + ...
        0.6*rainfallTable.Rainfall_mm(i);
end
soilMoisture = table(rainfallTable.Date,round(moisture,1), ...
    'VariableNames',{'Date','SoilMoisture_pct'});
end


%% ============================================================
% LOCAL FUNCTION - HISTORICAL CATALOG
%% ============================================================
function catalog = loadLandslideCatalog(filepath)
if nargin >= 1 && isfile(filepath)
    catalog = readtable(filepath);
    catalog = rmmissing(catalog);
else
    warning('loadLandslideCatalog:fileNotFound', ...
        'CSV not found at "%s" -- using synthetic placeholder catalog.', ...
        string(filepath));
    eventDate = datetime({'2023-07-12','2023-08-03','2024-06-21'})';
    location = {'Sector A','Sector B','Sector A'}';
    severity = {'Moderate','Severe','Minor'}';
    catalog = table(eventDate,location,severity, ...
        'VariableNames',{'EventDate','Location','Severity'});
end
end


%% ============================================================
% LOCAL FUNCTION - DATA FACTOR OF SAFETY
%% ============================================================
function FS = computeSlopeStability(slopeAngle_deg,cohesion_kPa,soilMoisture_pct)
unitWeight = 18;
soilDepth = 2;
phi = 30;
beta = deg2rad(slopeAngle_deg);
u = (soilMoisture_pct/100).*unitWeight.*soilDepth.*0.5;
numerator = cohesion_kPa + ...
    (unitWeight.*soilDepth.*cos(beta).^2-u).*tand(phi);
denominator = unitWeight.*soilDepth.*sin(beta).*cos(beta);
FS = numerator./denominator;
FS(denominator <= 0) = Inf;
end


%% ============================================================
% LOCAL FUNCTION - DATA RAINFALL RISK
%% ============================================================
function riskFactor = computeRainfallRiskFactor(rainfallTable,windowDays)
if nargin < 2
    windowDays = 3;
end
n = height(rainfallTable);
cumulativeRain = zeros(n,1);
for i = 1:n
    startIdx = max(1,i-windowDays+1);
    cumulativeRain(i) = sum(rainfallTable.Rainfall_mm(startIdx:i));
end
riskFactor = min(cumulativeRain/150,1);
end


%% ============================================================
% LOCAL FUNCTION - DATA RISK LEVEL
%% ============================================================
function level = classifyRiskLevel(riskScore)
level = strings(size(riskScore));
level(riskScore < 30) = "Low";
level(riskScore >= 30 & riskScore < 60) = "Moderate";
level(riskScore >= 60 & riskScore < 80) = "High";
level(riskScore >= 80) = "Severe";
end


%% ============================================================
% LOCAL FUNCTION - DATA COMBINED RISK SCORE
%% ============================================================
function [riskScore,riskLevel] = computeLandslideRiskScore(FS,rainfallRiskFactor)
instability = max(0,min(1,(2-FS)/1.5));
combined = 0.6*instability + 0.4*rainfallRiskFactor;
riskScore = round(combined*100,1);
riskLevel = classifyRiskLevel(riskScore);
end


%% ============================================================
% LOCAL FUNCTION - HOURLY RAINFALL EVENT
%% ============================================================
function rainfall = createRainfallEvent(intensity)
rainfall = [ ...
    0 ...
    intensity*0.10 ...
    intensity*0.20 ...
    intensity*0.30 ...
    intensity*0.40 ...
    intensity*0.60 ...
    intensity*0.80 ...
    intensity];
end


%% ============================================================
% LOCAL FUNCTION - HOURLY DIGITAL-TWIN SIMULATION
%% ============================================================
function [FoS_time,soilSaturation,porePressure,minimumFoS] = ...
    calculateSimulation(rainfall,slopeRadiansSafe,cohesion, ...
    frictionRadians,gamma,soilDepth,gammaWater, ...
    soilWaterCapacity,infiltrationFraction)

infiltratedRain = rainfall.*infiltrationFraction;
soilWater = zeros(size(rainfall));

for t = 1:length(rainfall)
    if t == 1
        soilWater(t) = min(infiltratedRain(t),soilWaterCapacity);
    else
        soilWater(t) = min(soilWater(t-1)+infiltratedRain(t),soilWaterCapacity);
    end
end

soilSaturation = soilWater./soilWaterCapacity;
soilSaturation = min(soilSaturation,1);

porePressure = soilSaturation.*gammaWater.*soilDepth;

numRows = size(slopeRadiansSafe,1);
numCols = size(slopeRadiansSafe,2);

FoS_time = zeros(numRows,numCols,length(rainfall));

for t = 1:length(rainfall)
    u = soilSaturation(t).*gammaWater.*soilDepth.*cos(slopeRadiansSafe).^2;
    effectiveNormalStress = gamma.*soilDepth.*cos(slopeRadiansSafe).^2-u;
    FoS_time(:,:,t) = ...
        (cohesion+effectiveNormalStress.*tan(frictionRadians)) ...
        ./ ...
        (gamma.*soilDepth.*sin(slopeRadiansSafe).*cos(slopeRadiansSafe));
end

minimumFoS = zeros(size(rainfall));
for t = 1:length(rainfall)
    minimumFoS(t) = min(FoS_time(:,:,t),[],'all');
end
end


%% ============================================================
% LOCAL FUNCTION - UPDATE DASHBOARD
