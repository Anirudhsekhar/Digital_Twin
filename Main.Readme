%% ============================================================
% 20. INITIAL DISPLAY
%% ============================================================

updateDashboard( ...
    dashboard, ...
    dashboardAxes, ...
    fosAxes, ...
    rainAxes, ...
    riskLabel, ...
    fosLabel, ...
    rainfallLabel, ...
    saturationLabel, ...
    pressureLabel, ...
    areaLabel, ...
    housesLabel, ...
    roadsLabel, ...
    hourLabel, ...
    hourStatusLabel, ...
