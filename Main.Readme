xlabel(fosAxes,'Time');

ylabel(fosAxes,'Min FoS');

title(fosAxes,'SLOPE STABILITY','FontWeight','bold');

grid(fosAxes,'on');


% ------------------------------------------------------------
% RAINFALL AXES
% ------------------------------------------------------------

rainAxes = uiaxes( ...
    analyticsPanel, ...
    'Position',[480 10 450 105], ...
    'BackgroundColor',[0.07 0.075 0.09], ...
    'XColor',[0.68 0.69 0.73], ...
    'YColor',[0.68 0.69 0.73], ...
    'FontSize',8);


xlabel(rainAxes,'Time');

ylabel(rainAxes,'Rain');

title(rainAxes,'RAINFALL EVENT','FontWeight','bold');

grid(rainAxes,'on');


%% ============================================================
% 17. RECOMMENDED ACTION
%% ============================================================

actionPanel = uipanel( ...
    dashboard, ...
    'Position',[980 15 455 140], ...
    'Title','  RECOMMENDED ACTION', ...
    'FontSize',12, ...
    'FontWeight','bold', ...
    'BackgroundColor',[0.07 0.075 0.09], ...
    'ForegroundColor',[0.92 0.92 0.94]);


actionLabel = uilabel( ...
    actionPanel, ...
    'Position',[25 35 405 65], ...
    'Text','MONITOR REGION', ...
    'FontSize',20, ...
    'FontWeight','bold', ...
    'HorizontalAlignment','center', ...
    'VerticalAlignment','center', ...
    'FontColor',[0.30 0.80 0.45]);


%% ============================================================
% 18. STORE STATE
%% ============================================================

state = struct();

state.x = x;

state.y = y;

state.slopeRadiansSafe = ...
    slopeRadiansSafe;

state.cohesion = cohesion;

state.frictionRadians = ...
    frictionRadians;

state.gamma = gamma;

state.soilDepth = soilDepth;

state.gammaWater = ...
    gammaWater;

state.soilWaterCapacity = ...
    soilWaterCapacity;

state.infiltrationFraction = ...
    infiltrationFraction;

state.time = time;

state.rainfall = rainfall;

state.FoS_time = FoS_time;

state.soilSaturation = ...
    soilSaturation;

state.porePressure = ...
    porePressure;

state.minimumFoS = ...
    minimumFoS;

state.houses = houses;

state.roads = roads;


dashboard.UserData = state;


%% ============================================================
% 19. CALLBACKS
%% ============================================================

timeSlider.ValueChangedFcn = ...
    @(src,event) updateDashboard( ...
    dashboard, ...
    dashboardAxes, ...
    fosAxes, ...
    rainAxes, ...
