    'Text','AFFECTED AREA', ...
    'FontSize',10, ...
    'FontWeight','bold', ...
    'FontColor',[0.55 0.57 0.62]);


areaLabel = uilabel( ...
    areaCard, ...
    'Position',[20 8 400 30], ...
    'Text','0.00 km²', ...
    'FontSize',20, ...
    'FontWeight','bold', ...
    'FontColor',[0.94 0.94 0.95]);


% ------------------------------------------------------------
% HOUSES CARD
% ------------------------------------------------------------

housesCard = uipanel( ...
    metricsPanel, ...
    'Position',[475 5 450 70], ...
    'BackgroundColor',[0.075 0.08 0.095], ...
    'BorderType','none');


uilabel( ...
