currentRainfall = state.rainfall(tIndex);
currentSaturation = state.soilSaturation(tIndex);
currentPressure = state.porePressure(tIndex);
currentMinimumFoS = min(currentFoS(:));
cumulativeRainfall = sum(state.rainfall(1:tIndex));

%% RISK MAP
riskMap = zeros(size(currentFoS));
riskMap(currentFoS > 1.5) = 1;
riskMap(currentFoS >= 1.2 & currentFoS <= 1.5) = 2;
riskMap(currentFoS >= 1.0 & currentFoS < 1.2) = 3;
riskMap(currentFoS < 1.0) = 4;

totalCells = numel(currentFoS);
extremePercentage = sum(currentFoS(:) < 1.0)/totalCells*100;
highPercentage = sum(currentFoS(:) >= 1.0 & currentFoS(:) < 1.2)/totalCells*100;
moderatePercentage = sum(currentFoS(:) >= 1.2 & currentFoS(:) <= 1.5)/totalCells*100;

if extremePercentage >= 20
    overallRisk = "EXTREME";
    action = "IMMEDIATE EVACUATION";
    riskColor = [0.90 0.20 0.25];
elseif extremePercentage >= 5 || highPercentage >= 25
    overallRisk = "HIGH";
    action = "EVACUATE HIGH-RISK REGION";
    riskColor = [0.95 0.50 0.20];
elseif highPercentage >= 10 || moderatePercentage >= 25
    overallRisk = "MODERATE";
    action = "ISSUE WARNING";
    riskColor = [0.95 0.78 0.20];
else
    overallRisk = "LOW";
    action = "MONITOR REGION";
    riskColor = [0.30 0.80 0.45];
end

%% INFRASTRUCTURE
houses = state.houses;
houseX = round(houses(:,1));
houseY = round(houses(:,2));
houseX = max(1,min(size(currentFoS,2),houseX));
houseY = max(1,min(size(currentFoS,1),houseY));
houseFoS = zeros(size(houseX));
for h = 1:length(houseX)
    houseFoS(h) = currentFoS(houseY(h),houseX(h));
end
affectedHouse = houseFoS < 1.2;
safeHouse = ~affectedHouse;
affectedHouses = sum(affectedHouse);

roads = state.roads;
roadX = roads(:,1);
roadY = roads(:,2);
roadXi = round(roadX);
roadYi = round(roadY);
roadXi = max(1,min(size(currentFoS,2),roadXi));
roadYi = max(1,min(size(currentFoS,1),roadYi));
roadFoS = zeros(size(roadXi));
for r = 1:length(roadXi)
    roadFoS(r) = currentFoS(roadYi(r),roadXi(r));
end
affectedRoad = roadFoS < 1.2;
affectedRoadPoints = sum(affectedRoad);
roadPercentage = affectedRoadPoints/length(roadX)*100;
if roadPercentage >= 20
    affectedRoads = 1;
else
    affectedRoads = 0;
end

affectedCells = currentFoS < 1.2;
cellArea = 0.001;
affectedArea = sum(affectedCells(:))*cellArea;

%% DRAW MAP
cla(dashboardAxes);
imagesc(dashboardAxes,state.x(1,:),state.y(:,1),riskMap);
axis(dashboardAxes,'image');
set(dashboardAxes,'YDir','normal');
colormap(dashboardAxes,[ ...
    0.25 0.70 0.42
    0.90 0.78 0.20
    0.92 0.48 0.18
    0.82 0.18 0.20]);
caxis(dashboardAxes,[1 4]);
hold(dashboardAxes,'on');

safeLegend = scatter(dashboardAxes,houseX(safeHouse),houseY(safeHouse), ...
    45,'o','MarkerFaceColor',[0.20 0.90 0.45], ...
    'MarkerEdgeColor',[1 1 1],'LineWidth',1);
affectedLegend = scatter(dashboardAxes,houseX(affectedHouse),houseY(affectedHouse), ...
    80,'o','MarkerFaceColor',[0.95 0.08 0.08], ...
    'MarkerEdgeColor',[1 1 1],'LineWidth',2);
roadLegend = plot(dashboardAxes,roadX,roadY,'-', ...
    'Color',[0.95 0.95 0.95],'LineWidth',3);
affectedRoadLegend = plot(dashboardAxes,nan,nan,'-', ...
    'Color',[0.95 0.08 0.08],'LineWidth',5);

for r = 1:length(roadX)-1
    if affectedRoad(r) || affectedRoad(r+1)
        plot(dashboardAxes,roadX(r:r+1),roadY(r:r+1),'-', ...
            'Color',[0.95 0.08 0.08],'LineWidth',6);
    end
end

xlabel(dashboardAxes,'X Coordinate');
ylabel(dashboardAxes,'Y Coordinate');
title(dashboardAxes,sprintf('LIVE RISK MAP  |  HOUR %d',currentHour), ...
    'FontWeight','bold');
legend(dashboardAxes,[safeLegend affectedLegend roadLegend affectedRoadLegend], ...
    {'Safe House','Affected House','Road','Affected Road'}, ...
    'Location','southoutside','FontSize',7);
hold(dashboardAxes,'off');

%% UPDATE STATUS
riskLabel.Text = char(overallRisk);
riskLabel.FontColor = riskColor;
fosLabel.Text = sprintf('%.2f',currentMinimumFoS);
rainfallLabel.Text = sprintf('%.0f mm',cumulativeRainfall);
saturationLabel.Text = sprintf('%.0f %%',currentSaturation*100);
pressureLabel.Text = sprintf('%.1f kPa',currentPressure);
hourLabel.Text = sprintf('HOUR %d',currentHour);
hourStatusLabel.Text = sprintf('SIMULATION TIME   HOUR %d',currentHour);
rainValueLabel.Text = sprintf('Rainfall this hour: %.0f mm',currentRainfall);
areaLabel.Text = sprintf('%.2f km²',affectedArea);
housesLabel.Text = sprintf('%d / %d',affectedHouses,length(houses));
roadsLabel.Text = sprintf('%d / 1',affectedRoads);
actionLabel.Text = char(action);
actionLabel.FontColor = riskColor;

%% FoS ANALYTICS
cla(fosAxes);
plot(fosAxes,state.time,state.minimumFoS,'-o','LineWidth',2);
hold(fosAxes,'on');
plot(fosAxes,currentHour,currentMinimumFoS,'o','MarkerSize',8,'LineWidth',2);
yline(fosAxes,1.0,'--','FoS 1.0');
yline(fosAxes,1.2,'--','FoS 1.2');
hold(fosAxes,'off');
xlabel(fosAxes,'Time');
ylabel(fosAxes,'Min FoS');
title(fosAxes,'SLOPE STABILITY','FontWeight','bold');
grid(fosAxes,'on');

%% RAINFALL ANALYTICS
cla(rainAxes);
bar(rainAxes,state.time,state.rainfall);
hold(rainAxes,'on');
plot(rainAxes,currentHour,currentRainfall,'o','MarkerSize',8,'LineWidth',2);
hold(rainAxes,'off');
xlabel(rainAxes,'Time');
ylabel(rainAxes,'Rain');
title(rainAxes,'RAINFALL EVENT','FontWeight','bold');
grid(rainAxes,'on');

%% ============================================================
% EARLY-WARNING FORECAST
% ============================================================
forecastHorizon = state.forecastHorizon;
[forecastTime,forecastRainfall,forecastSaturation,forecastPorePressure, ...
    forecastMinimumFoS,earlyWarningActive,hoursUntilWarning,forecastMessage] = ...
    calculateForecast( ...
    tIndex,state.time,state.rainfall,state.soilSaturation, ...
    state.infiltrationFraction,state.soilWaterCapacity,state.gammaWater, ...
    state.soilDepth,state.gamma,state.cohesion,state.frictionRadians, ...
    state.slopeRadiansSafe,forecastHorizon);

% The current condition always takes priority over a future warning.
if currentMinimumFoS < 1.0
    forecastStatusLabel.Text = sprintf( ...
        'CURRENT CONDITION: CRITICAL  |  FoS %.2f',currentMinimumFoS);
    forecastStatusLabel.FontColor = [0.90 0.20 0.25];
elseif currentMinimumFoS < 1.2
    forecastStatusLabel.Text = sprintf( ...
        'CURRENT CONDITION: HIGH RISK  |  FoS %.2f',currentMinimumFoS);
    forecastStatusLabel.FontColor = [0.95 0.50 0.20];
elseif earlyWarningActive
    forecastStatusLabel.Text = sprintf( ...
        'EARLY WARNING: RISK IN %d HOUR(S)',hoursUntilWarning);
    forecastStatusLabel.FontColor = [0.95 0.50 0.20];
else
    forecastStatusLabel.Text = 'NO CRITICAL RISK PREDICTED';
    forecastStatusLabel.FontColor = [0.30 0.80 0.45];
end

forecastDetailLabel.Text = sprintf( ...
    ['H%d  %.2f  |  H%d  %.2f  |  H%d  %.2f  |  H%d  %.2f\n' ...
     'Rain %.0f → %.0f → %.0f → %.0f mm  |  Final saturation %.0f%%\n' ...
     '%s'], ...
    forecastTime(1),forecastMinimumFoS(1), ...
    forecastTime(2),forecastMinimumFoS(2), ...
    forecastTime(3),forecastMinimumFoS(3), ...
    forecastTime(4),forecastMinimumFoS(4), ...
    forecastRainfall(1),forecastRainfall(2), ...
    forecastRainfall(3),forecastRainfall(4), ...
    forecastSaturation(4)*100,forecastMessage);

state.forecastTime = forecastTime;
state.forecastRainfall = forecastRainfall;
state.forecastSaturation = forecastSaturation;
state.forecastPorePressure = forecastPorePressure;
state.forecastMinimumFoS = forecastMinimumFoS;
dashboard.UserData = state;

drawnow;
end


%% ============================================================
% LOCAL FUNCTION - APPLY RAINFALL
%% ============================================================
function applyRainfall( ...
    dashboard,rainfallInput,timeSlider, ...
    dashboardAxes,fosAxes,rainAxes, ...
    forecastStatusLabel,forecastDetailLabel, ...
    riskLabel,fosLabel,rainfallLabel,saturationLabel,pressureLabel, ...
    areaLabel,housesLabel,roadsLabel,hourLabel,hourStatusLabel, ...
    rainValueLabel,actionLabel)

intensity = rainfallInput.Value;
if isempty(intensity) || isnan(intensity) || intensity < 0
    intensity = 0;
    rainfallInput.Value = 0;
end

rainfall = createRainfallEvent(intensity);
state = dashboard.UserData;

[FoS_time,soilSaturation,porePressure,minimumFoS] = ...
    calculateSimulation( ...
    rainfall,state.slopeRadiansSafe,state.cohesion,state.frictionRadians, ...
    state.gamma,state.soilDepth,state.gammaWater, ...
    state.soilWaterCapacity,state.infiltrationFraction);

averageFoS = zeros(size(rainfall));
for t = 1:length(rainfall)
    averageFoS(t) = mean(FoS_time(:,:,t),'all');
end

state.rainfall = rainfall;
state.FoS_time = FoS_time;
state.soilSaturation = soilSaturation;
state.porePressure = porePressure;
state.minimumFoS = minimumFoS;
state.averageFoS = averageFoS;
dashboard.UserData = state;

timeSlider.Limits = [1 length(rainfall)];
timeSlider.MajorTicks = 1:length(rainfall);
timeSlider.Value = 1;

updateDashboard( ...
    dashboard,timeSlider,dashboardAxes,fosAxes,rainAxes, ...
    forecastStatusLabel,forecastDetailLabel, ...
    riskLabel,fosLabel,rainfallLabel,saturationLabel,pressureLabel, ...
    areaLabel,housesLabel,roadsLabel,hourLabel,hourStatusLabel, ...
    rainValueLabel,actionLabel);
end


%% ============================================================
% LOCAL FUNCTION - DYNAMIC 4-HOUR FORECAST
%% ============================================================
function [ ...
    forecastTime,forecastRainfall,forecastSaturation,forecastPorePressure, ...
    forecastMinimumFoS,earlyWarningActive,hoursUntilWarning,earlyWarningText] = ...
    calculateForecast( ...
    tIndex,time,rainfall,soilSaturation,infiltrationFraction, ...
    soilWaterCapacity,gammaWater,soilDepth,gamma,cohesion, ...
    frictionRadians,slopeRadiansSafe,forecastHorizon)

currentHour = time(tIndex);
forecastTime = currentHour + (1:forecastHorizon);
observedRainfall = rainfall(1:tIndex);

if length(observedRainfall) >= 3
    recentRainfall = observedRainfall(end-2:end);
    rainfallTrend = mean(diff(recentRainfall));
elseif length(observedRainfall) == 2
    rainfallTrend = observedRainfall(end)-observedRainfall(end-1);
else
    rainfallTrend = 0;
end

forecastRainfall = zeros(1,forecastHorizon);
lastRain = rainfall(tIndex);

for k = 1:forecastHorizon
    nextRain = max(lastRain+rainfallTrend,0);
    forecastRainfall(k) = nextRain;
    lastRain = nextRain;
end

forecastInfiltratedRain = forecastRainfall*infiltrationFraction;
forecastSoilWater = zeros(1,forecastHorizon);
lastSoilWater = soilSaturation(tIndex)*soilWaterCapacity;

for k = 1:forecastHorizon
    lastSoilWater = min( ...
        lastSoilWater+forecastInfiltratedRain(k), ...
        soilWaterCapacity);
    forecastSoilWater(k) = lastSoilWater;
end

forecastSaturation = min( ...
    forecastSoilWater/soilWaterCapacity,1);

forecastPorePressure = ...
    forecastSaturation*gammaWater*soilDepth;

forecastMinimumFoS = zeros(1,forecastHorizon);

for k = 1:forecastHorizon
    u = forecastSaturation(k)*gammaWater*soilDepth ...
        .* cos(slopeRadiansSafe).^2;
    effectiveNormalStress = gamma*soilDepth ...
        .* cos(slopeRadiansSafe).^2-u;
    forecastFoS = ...
        (cohesion+effectiveNormalStress.*tan(frictionRadians)) ...
        ./ ...
        (gamma*soilDepth.*sin(slopeRadiansSafe).*cos(slopeRadiansSafe));
    forecastMinimumFoS(k) = min(forecastFoS(:));
end

warningHourIndex = find(forecastMinimumFoS < 1.2,1,'first');
failureHourIndex = find(forecastMinimumFoS < 1.0,1,'first');

if ~isempty(failureHourIndex)
    hoursUntilWarning = failureHourIndex;
    earlyWarningActive = true;
    earlyWarningText = sprintf( ...
        'Critical FoS < 1.0 predicted in %d hour(s).',hoursUntilWarning);
elseif ~isempty(warningHourIndex)
    hoursUntilWarning = warningHourIndex;
    earlyWarningActive = true;
    earlyWarningText = sprintf( ...
        'FoS < 1.2 predicted in %d hour(s).',hoursUntilWarning);
else
    hoursUntilWarning = NaN;
    earlyWarningActive = false;
    earlyWarningText = ...
        'No threshold crossing predicted in the next 4 hours.';
end
end

