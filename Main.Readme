%% ============================================================
% 16. ANALYTICS PANEL
%% ============================================================

analyticsPanel = uipanel( ...
    dashboard, ...
    'Position',[15 15 950 140], ...
    'Title','  STABILITY ANALYTICS', ...
    'FontSize',12, ...
    'FontWeight','bold', ...
    'BackgroundColor',[0.07 0.075 0.09], ...
