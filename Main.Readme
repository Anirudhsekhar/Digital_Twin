%% ============================================================
% LANDSLIDE DIGITAL TWIN
% MATLAB INTERACTIVE DASHBOARD
%
% Complete clean version
% No GridLayout dependency
%
% Features:
% - Terrain generation
% - Slope calculation
% - Factor of Safety
% - Rainfall simulation
% - Soil saturation
% - Pore pressure
% - Live risk map
% - Houses and roads
% - Affected infrastructure
% - Rainfall input
% - Time slider
% - Stability graph
% - Rainfall graph
%% ============================================================

clear;
clc;
close all;


%% ============================================================
% 1. TERRAIN
%% ============================================================

gridSize = 100;

[x,y] = meshgrid(1:gridSize,1:gridSize);


terrain = ...
    150 ...
    - 0.8*x ...
    + 10*exp( ...
    -((x-70).^2 + ...
    (y-50).^2)/500);


%% ============================================================
% 2. TERRAIN GRADIENT
%% ============================================================

[dzdx,dzdy] = gradient(terrain);


slopeRadians = ...
    atan( ...
    sqrt( ...
    dzdx.^2 + ...
    dzdy.^2));


slopeDegrees = ...
    rad2deg(slopeRadians);


slopeRadiansSafe = ...
    max( ...
    slopeRadians, ...
    deg2rad(0.5));


%% ============================================================
% 3. SOIL PARAMETERS
%% ============================================================

cohesion = 15;              % kPa

frictionAngle = 30;        % degrees

soilDensity = 1800;        % kg/m^3

soilDepth = 5;             % m

gamma = ...
    soilDensity * 9.81 / 1000;

frictionRadians = ...
    deg2rad(frictionAngle);


%% ============================================================
% 4. DRY FACTOR OF SAFETY
%% ============================================================

FoS = ...
    ( ...
    cohesion ...
    + gamma*soilDepth .* ...
    cos(slopeRadiansSafe).^2 .* ...
    tan(frictionRadians) ...
    ) ...
    ./ ...
    ( ...
    gamma*soilDepth .* ...
    sin(slopeRadiansSafe) .* ...
    cos(slopeRadiansSafe) ...
    );


%% ============================================================
% 5. RAINFALL PARAMETERS
%% ============================================================

defaultRainfall = 50;

numHours = 8;

time = 0:numHours-1;

infiltrationFraction = 0.60;

soilWaterCapacity = 150;

gammaWater = 9.81;


%% ============================================================
% 6. INITIAL RAINFALL EVENT
%% ============================================================

rainfall = createRainfallEvent(defaultRainfall);


%% ============================================================
% 7. INITIAL SIMULATION
%% ============================================================

[
    FoS_time, ...
    soilSaturation, ...
    porePressure, ...
    minimumFoS ...
    ] = calculateSimulation( ...
    rainfall, ...
    slopeRadiansSafe, ...
    cohesion, ...
    frictionRadians, ...
    gamma, ...
    soilDepth, ...
    gammaWater, ...
    soilWaterCapacity, ...
    infiltrationFraction);


%% ============================================================
% 8. SIMULATED INFRASTRUCTURE
%% ============================================================
%
% These are prototype locations for the digital twin.
% They are NOT real GIS infrastructure data.
%% ============================================================

rng(1);


% ------------------------------------------------------------
% HOUSES
% ------------------------------------------------------------

houses = ...
    [ ...
    randi([10 90],24,1), ...
    randi([10 90],24,1) ...
    ];


% ------------------------------------------------------------
% ROAD
% ------------------------------------------------------------

roadX = ...
    linspace(5,95,150)';


roadY = ...
    20 ...
    + 0.35*roadX ...
    + 8*sin(roadX/12);


roads = ...
    [roadX roadY];


%% ============================================================
% 9. CREATE MAIN WINDOW
%% ============================================================

dashboard = uifigure( ...
    'Name','Landslide Digital Twin Dashboard', ...
    'Position',[50 40 1450 850], ...
    'Color',[0.055 0.06 0.075]);


%% ============================================================
% 10. HEADER
%% ============================================================

headerPanel = uipanel( ...
    dashboard, ...
    'Position',[15 780 1420 55], ...
    'BackgroundColor',[0.075 0.08 0.095], ...
    'BorderType','none');


titleLabel = uilabel( ...
    headerPanel, ...
    'Position',[20 8 500 40], ...
    'Text','LANDSLIDE DIGITAL TWIN', ...
    'FontSize',24, ...
    'FontWeight','bold', ...
    'FontColor',[0.96 0.96 0.97]);


subtitleLabel = uilabel( ...
    headerPanel, ...
    'Position',[850 12 530 30], ...
    'Text','SLOPE STABILITY  |  DIGITAL TWIN MONITORING', ...
    'FontSize',12, ...
    'FontWeight','bold', ...
    'HorizontalAlignment','right', ...
    'FontColor',[0.58 0.60 0.65]);


%% ============================================================
% 11. MAP PANEL
%% ============================================================

mapPanel = uipanel( ...
    dashboard, ...
    'Position',[15 375 950 390], ...
    'Title','  LIVE RISK MAP', ...
    'FontSize',12, ...
    'FontWeight','bold', ...
    'BackgroundColor',[0.07 0.075 0.09], ...
    'ForegroundColor',[0.92 0.92 0.94]);


dashboardAxes = uiaxes( ...
    mapPanel, ...
    'Position',[10 10 930 350], ...
    'BackgroundColor',[0.07 0.075 0.09], ...
    'XColor',[0.72 0.73 0.76], ...
    'YColor',[0.72 0.73 0.76], ...
    'FontSize',10);


xlabel(dashboardAxes,'X Coordinate');

ylabel(dashboardAxes,'Y Coordinate');


%% ============================================================
% 12. STATUS PANEL
%% ============================================================

statusPanel = uipanel( ...
    dashboard, ...
    'Position',[980 375 455 390], ...
    'Title','  CURRENT STATUS', ...
    'FontSize',12, ...
    'FontWeight','bold', ...
    'BackgroundColor',[0.07 0.075 0.09], ...
    'ForegroundColor',[0.92 0.92 0.94]);


% ------------------------------------------------------------
% CURRENT RISK
% ------------------------------------------------------------

uilabel( ...
    statusPanel, ...
    'Position',[25 310 170 25], ...
    'Text','CURRENT RISK', ...
    'FontSize',11, ...
    'FontWeight','bold', ...
    'FontColor',[0.55 0.57 0.62]);


riskLabel = uilabel( ...
    statusPanel, ...
    'Position',[220 300 200 45], ...
    'Text','HIGH', ...
    'FontSize',25, ...
    'FontWeight','bold', ...
    'HorizontalAlignment','right', ...
    'FontColor',[0.95 0.50 0.20]);


% ------------------------------------------------------------
% MINIMUM FoS
% ------------------------------------------------------------

uilabel( ...
    statusPanel, ...
    'Position',[25 255 170 25], ...
    'Text','MINIMUM FoS', ...
    'FontSize',11, ...
    'FontWeight','bold', ...
    'FontColor',[0.55 0.57 0.62]);


fosLabel = uilabel( ...
    statusPanel, ...
    'Position',[220 250 200 35], ...
    'Text','0.83', ...
    'FontSize',20, ...
    'FontWeight','bold', ...
    'HorizontalAlignment','right', ...
    'FontColor',[0.94 0.94 0.95]);


% ------------------------------------------------------------
% RAINFALL
% ------------------------------------------------------------

uilabel( ...
    statusPanel, ...
    'Position',[25 205 170 25], ...
    'Text','CUMULATIVE RAINFALL', ...
    'FontSize',11, ...
    'FontWeight','bold', ...
    'FontColor',[0.55 0.57 0.62]);


rainfallLabel = uilabel( ...
    statusPanel, ...
    'Position',[220 200 200 35], ...
    'Text','0 mm', ...
    'FontSize',18, ...
    'FontWeight','bold', ...
    'HorizontalAlignment','right', ...
    'FontColor',[0.94 0.94 0.95]);


% ------------------------------------------------------------
% SATURATION
% ------------------------------------------------------------

uilabel( ...
    statusPanel, ...
    'Position',[25 155 170 25], ...
    'Text','SOIL SATURATION', ...
    'FontSize',11, ...
    'FontWeight','bold', ...
    'FontColor',[0.55 0.57 0.62]);


saturationLabel = uilabel( ...
    statusPanel, ...
    'Position',[220 150 200 35], ...
    'Text','0 %', ...
    'FontSize',18, ...
    'FontWeight','bold', ...
    'HorizontalAlignment','right', ...
    'FontColor',[0.94 0.94 0.95]);


% ------------------------------------------------------------
% PORE PRESSURE
% ------------------------------------------------------------

uilabel( ...
    statusPanel, ...
    'Position',[25 105 170 25], ...
    'Text','PORE PRESSURE', ...
    'FontSize',11, ...
    'FontWeight','bold', ...
    'FontColor',[0.55 0.57 0.62]);


pressureLabel = uilabel( ...
    statusPanel, ...
    'Position',[220 100 200 35], ...
    'Text','0.0 kPa', ...
    'FontSize',18, ...
    'FontWeight','bold', ...
    'HorizontalAlignment','right', ...
    'FontColor',[0.94 0.94 0.95]);


% ------------------------------------------------------------
% CURRENT HOUR
% ------------------------------------------------------------

hourStatusLabel = uilabel( ...
    statusPanel, ...
    'Position',[25 40 395 40], ...
    'Text','SIMULATION TIME   HOUR 0', ...
    'FontSize',13, ...
    'FontWeight','bold', ...
    'HorizontalAlignment','center', ...
    'FontColor',[0.45 0.75 0.95]);


%% ============================================================
% 13. RAINFALL CONTROL PANEL
%% ============================================================

controlPanel = uipanel( ...
    dashboard, ...
    'Position',[15 255 1420 105], ...
    'Title','  RAINFALL SIMULATION', ...
    'FontSize',12, ...
    'FontWeight','bold', ...
    'BackgroundColor',[0.07 0.075 0.09], ...
    'ForegroundColor',[0.92 0.92 0.94]);


% ------------------------------------------------------------
% INPUT LABEL
% ------------------------------------------------------------

uilabel( ...
    controlPanel, ...
    'Position',[20 48 160 25], ...
    'Text','Rainfall intensity', ...
    'FontSize',12, ...
    'FontWeight','bold', ...
    'FontColor',[0.68 0.70 0.75]);


% ------------------------------------------------------------
% INPUT FIELD
% ------------------------------------------------------------

rainfallInput = uieditfield( ...
    controlPanel, ...
    'numeric', ...
    'Position',[180 45 150 32], ...
    'Value',defaultRainfall, ...
    'Limits',[0 Inf], ...
    'FontSize',14);


% ------------------------------------------------------------
% UNIT
% ------------------------------------------------------------

uilabel( ...
    controlPanel, ...
    'Position',[340 48 80 25], ...
    'Text','mm/hr', ...
    'FontSize',12, ...
    'FontWeight','bold', ...
    'FontColor',[0.58 0.60 0.65]);


% ------------------------------------------------------------
% APPLY BUTTON
% ------------------------------------------------------------

applyButton = uibutton( ...
    controlPanel, ...
    'push', ...
    'Position',[430 44 170 34], ...
    'Text','APPLY RAINFALL', ...
    'FontSize',12, ...
    'FontWeight','bold');


% ------------------------------------------------------------
% CURRENT HOUR
% ------------------------------------------------------------

hourLabel = uilabel( ...
    controlPanel, ...
    'Position',[630 47 150 25], ...
    'Text','HOUR 0', ...
    'FontSize',15, ...
    'FontWeight','bold', ...
    'HorizontalAlignment','center', ...
    'FontColor',[0.94 0.94 0.95]);


% ------------------------------------------------------------
% CURRENT HOUR RAIN
% ------------------------------------------------------------

rainValueLabel = uilabel( ...
    controlPanel, ...
    'Position',[1050 47 330 25], ...
    'Text','Rainfall this hour: 0 mm', ...
    'FontSize',12, ...
    'HorizontalAlignment','right', ...
    'FontColor',[0.65 0.67 0.72]);


%% ============================================================
% 14. TIME SLIDER
%% ============================================================

% IMPORTANT:
% This is directly positioned inside the panel.
% It is NOT inside a GridLayout.

timeSlider = uislider( ...
    controlPanel, ...
    'Position',[185 18 1080 3], ...
    'Limits',[1 8], ...
    'Value',1, ...
    'MajorTicks',1:8, ...
    'MinorTicks',[]);


% ------------------------------------------------------------
% SLIDER END LABELS
% ------------------------------------------------------------

uilabel( ...
    controlPanel, ...
    'Position',[20 8 100 20], ...
    'Text','HOUR 0', ...
    'FontSize',10, ...
    'FontColor',[0.55 0.57 0.62]);


uilabel( ...
    controlPanel, ...
    'Position',[1280 8 100 20], ...
    'Text','HOUR 7', ...
    'FontSize',10, ...
    'HorizontalAlignment','right', ...
    'FontColor',[0.55 0.57 0.62]);


%% ============================================================
% 15. INFRASTRUCTURE METRICS
%% ============================================================

metricsPanel = uipanel( ...
    dashboard, ...
    'Position',[15 165 1420 80], ...
    'BackgroundColor',[0.055 0.06 0.075], ...
    'BorderType','none');


% ------------------------------------------------------------
% AREA CARD
% ------------------------------------------------------------

areaCard = uipanel( ...
    metricsPanel, ...
    'Position',[0 5 450 70], ...
